:null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937157278.html","source":"东方财富快讯"}]},{"id":"evt-0ec5815ef1eaca478cb1a6ee","entityCode":"159001","entityName":"货币ETF易方达","title":"广发证券陈福：多举措协同发力 资本市场内在稳定性有望提升","summary":"【广发证券陈福：多举措协同发力 资本市场内在稳定性有望提升】广发证券非银首席分析师陈福认为，多项举措从融资端、交易端、投资端协同发力，资本市场内在稳定性有望进一步提升。陈福表示，据测算，此次下调融资保证金比例预计可带来近4000亿元增量资金，若成交额回升、风险偏好改善，持仓标的价格或企稳回升，担保比例有望随之改善。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937130690.html","kind":"资讯","entityCodes":["000776","159001"],"entities":[{"kind":"fund","code":"159001","name":"货币ETF易方达","basis":"source-security-code"},{"kind":"stock","code":"000776","name":"广发证券","basis":"unambiguous-name","matchedText":"广发证券"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937130690","publishedAt":"2026-11-23 11:30:00","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937130690.html","source":"东方财富快讯"}]},{"id":"evt-f5a49a0c4b475b044a6175b5","entityCode":"159001","entityName":"货币ETF易方达","title":"交易所降低融资保证金比例下限 可带来增量资金近4000亿元","summary":"【沪深北交易所降低融资保证金比例下限至80% 理论上可带来增量资金近4000亿元】经证监会批准，沪深北交易所将融资保证金比例下限从100%降低至80%，此次调整将自2026年11月30日起实施。据测算，此次调整理论上可带来增量资金近4000亿元。","date":"2026-11-22","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611223936924279.html","kind":"资讯","entityCodes":["159001","CN-MARKET"],"entities":[{"kind":"fund","code":"159001","name":"货币ETF易方达","basis":"source-security-code"},{"kind":"market","code":"CN-MARKET","name":"市场环境","basis":"market-context-only"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611223936924279","publishedAt":"2026-11-22 18:37:21","topics":[{"id":"capital","label":"资