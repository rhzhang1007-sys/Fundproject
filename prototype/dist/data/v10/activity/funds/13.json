money.com/a/202611233937180330.html","source":"东方财富快讯"}]},{"id":"evt-c206921a65d4b6123e7337eb","entityCode":"159813","entityName":"半导体ETF鹏华","title":"特朗普称只想向中国出售相对落后的芯片 外交部回应","summary":"【特朗普称只想向中国出售相对落后的芯片 外交部回应】11月23日，外交部发言人郭嘉昆主持例行记者会。路透社记者提问，美国总统特朗普称，美国只想向中国出售相对落后的芯片，并称美国政府正就此与中方进行讨论，中方对此有何回应？中方是否正与美方讨论购买此类芯片？","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937244051.html","kind":"资讯","entityCodes":["159813","CN-UNASSIGNED"],"entities":[{"kind":"fund","code":"159813","name":"半导体ETF鹏华","basis":"source-security-code"},{"kind":"unassigned","code":"CN-UNASSIGNED","name":"待归属资讯","basis":"source-read-entity-unresolved"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937244051","publishedAt":"2026-11-23 15:27:05","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937244051.html","source":"东方财富快讯"}]},{"id":"evt-97e3067818a4d4731d44b173","entityCode":"159813","entityName":"半导体ETF鹏华","title":"给化学反应中的分子配上“手机” 微型芯片可实时监测实验过程","summary":"【给化学反应中的分子配上“手机” 微型芯片可实时监测实验过程】把一枚比米粒还小的微型芯片放入试管底部，就能像手机一样与正在发生的化学反应“对话”，每隔半秒采集并无线传输一组数据，让化学反应实时“报告”自身状态——这是美国斯坦福大学和康奈尔大学研究团队开发出的名为“反应遥测”的新技术，实现了对化学反应过程的实时监测，有望加快新药发现和新材料研发。相关论文近日发表于《科学》杂志。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937033084.html","kind":"资讯","entityCodes":["159813","CN-UNASSIGNED"],"entities":[{"kind":"fund","code":"159813","name":"半导体ETF鹏华","basis":"source-security-code"},{"kind":"unassigned","code":"CN-UNASSIGNED","name":"待归属资讯","basis":"source-read-entity-unresolved"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937033084","publishedAt":"2026-11-23 07:28:47","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicat