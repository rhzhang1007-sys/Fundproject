{"schemaVersion":1,"objects":{"fund159813":{"news":[{"id":"evt-cc28bebcd6ba5705aa6462ac","entityCode":"159813","entityName":"半导体ETF鹏华","title":"高盛：三大条件满足之前 市场难言触底","summary":"【高盛：三大条件满足之前 市场难言触底】11月23日，美国科技股夜盘大幅反弹。其中，3倍做多半导体ETF-Direxion涨近15%，英伟达涨超7%。高盛在最新发布的《美国每周市场启动》报告中指出，支持美股见底并启动反弹的三大催化剂分别为：AI投资货币化前景获得投资者信心背书、美联储政策释放鸽派信号，以及机构投资者仓位出现大幅下降。但目前来看，三个条件均尚未成熟。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937180330.html","kind":"资讯","entityCodes":["159813"],"entities":[{"kind":"fund","code":"159813","name":"半导体ETF鹏华","basis":"source-security-code"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937180330","publishedAt":"2026-11-23 13:48:06","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937180330.html","source":"东方财富快讯"}]},{"id":"evt-c206921a65d4b6123e7337eb","entityCode":"159813","entityName":"半导体ETF鹏华","title":"特朗普称只想向中国出售相对落后的芯片 外交部回应","summary":"【特朗普称只想向中国出售相对落后的芯片 外交部回应】11月23日，外交部发言人郭嘉昆主持例行记者会。路透社记者提问，美国总统特朗普称，美国只想向中国出售相对落后的芯片，并称美国政府正就此与中方进行讨论，中方对此有何回应？中方是否正与美方讨论购买此类芯片？","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937244051.html","kind":"资讯","entityCodes":["159813"],"entities":[{"kind":"fund","code":"159813","name":"半导体ETF鹏华","basis":"source-security-code"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937244051","publishedAt":"2026-11-23 15:27:05","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937244051.html","source":"东方财富快讯"}]},{"id":"evt-97e3067818a4d4731d44b173","entityCode":"159813","entityName":"半导体ETF鹏华","title":"给化学反应中的分子配上“手机” 微型芯片可实时监测实验过程","summary":"【给化学反应中的分子配上“手机” 微型芯片可实时监测实验过程】把一枚比米粒还小的微型芯片放入试管底部，就能像手机一样与正在发生的化学反应“对话”，每隔半秒采集并无线传输一组数据，让化学反应实时“报告”自身状态——这是美国斯坦福大学和康奈尔大学研究团队开发出的名为“反应遥测”的新技术，实现了对化学反应过程的实时监测，有望加快新药发现和新材料研发。相关论文近日发表于《科学》杂志。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937033084.html","kind":"资讯","entityCodes":["159813"],"entities":[{"kind":"fund","code":"159813","name":"半导体ETF鹏华","basis":"source-security-code"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937033084","publishedAt":"2026-11-23 07:28:47","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937033084.html","source":"东方财富快讯"}]},{"id":"evt-6e755c6b801de1b54a14350b","entityCode":"159813","entityName":"半导体ETF鹏华","title":"美股纳指高开近7% 英伟达大涨33% 芯片股集体高开","summary":"【美股纳指高开近7% 英伟达大涨33% 芯片股集体高开】美股三大指数大幅高开，道琼斯指数涨2.78%，标普500指数涨4.93%，纳斯达克综合指数涨6.95%。受黄仁勋CEO职务恢复的消息刺激，芯片股集体高开，英伟达涨超33%，闪迪涨超24%，希捷科技涨超21%，台积电涨超20%，ARM、西部数据、拉姆研究、应用材料涨超17%，美光科技、Cerebras、英特尔涨超15%。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937627710.html","kind":"资讯","entityCodes":["159813"],"entities":[{"kind":"fund","code":"159813","name":"半导体ETF鹏华","basis":"source-security-code"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937627710","publishedAt":"2026-11-23 22:31:04","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937627710.html","source":"东方财富快讯"}]},{"id":"evt-64cfafbf68b866fea7f91fd9","entityCode":"159813","entityName":"半导体ETF鹏华","title":"