{"schemaVersion":1,"objects":{"fund161027":{"news":[{"id":"evt-7654471af52a4dd5d89bf3de","entityCode":"161027","entityName":"富国中证全指证券公司指数(LOF)A","title":"A股重磅！监管明确两融风控细则 稳妥处置违约","summary":"【监管明确两融调整要求 违约处置要稳妥审慎】今日，记者从业内获悉，监管部门向券商下发了《关于落实融资融券逆周期调节措施、提升风险管控有效性有关工作的通知》（下称《通知》）。《通知》称，在市场波动期间，在与客户充分沟通、取得确认的情况下，可动态调整最低维持担保比例及追保平仓安排，以时间换空间，保持适度弹性。违约处置要稳妥审慎，注意处置金额、时点、节奏，避免早盘尾市等时点集中卖出，冲击市场和个股，自觉维护市场稳定。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937278151.html","kind":"资讯","entityCodes":["161027","CN-MARKET"],"entities":[{"kind":"fund","code":"161027","name":"富国中证全指证券公司指数(LOF)A","basis":"source-security-code"},{"kind":"market","code":"CN-MARKET","name":"市场环境","basis":"market-context-only"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937278151","publishedAt":"2026-11-23 16:07:23","topics":[{"id":"policy","label":"政策与监管"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937278151.html","source":"东方财富快讯"}]},{"id":"evt-f8b1a6d603b05813e56d26b1","entityCode":"161027","entityName":"富国中证全指证券公司指数(LOF)A","title":"沪深交易所、中国结算推出一揽子降费措施","summary":"【沪深交易所、中国结算推出一揽子降费措施】记者11月22日从中国证监会了解到，沪深交易所推出新一批降费措施，包括免收交易单元使用费等，并将今年年初已实施的免收上市费、债券交易经手费等措施有效期再延长两年至2028年。中国结算明确，自2027年1月1日起至2028年12月31日，继续暂免收取绿色公司债券、科技创新公司债券和民营企业公司债券（不含可转换公司债券）发行人服务费及债券结算费。","date":"2026-11-22","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611223936924891.html","kind":"资讯","entityCodes":["161027","CN-MARKET"],"entities":[{"kind":"fund","code":"161027","name":"富国中证全指证券公司指数(LOF)A","basis":"source-security-code"},{"kind":"market","code":"CN-MARKET","name":"市场环境","basis":"market-context-only"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611223936924891","publishedAt":"2026-11-22 18:41:42","topics":[{"id":"other","label":"其他"}],"entityHints":[],"c