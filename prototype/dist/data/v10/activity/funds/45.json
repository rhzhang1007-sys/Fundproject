{"schemaVersion":1,"objects":{"fund159945":{"news":[{"id":"evt-f215d18d4478cc76c82a4b37","entityCode":"159945","entityName":"能源ETF广发","title":"高盛预计2027年全球经济增长2.8%，通胀放缓或推动部分央行年内降息","summary":"【高盛预计2027年全球经济增长2.8%，通胀放缓或推动部分央行年内降息】近日，高盛发布《2027年宏观经济展望：基准情景稳定，下行风险犹存》报告，预计2027年全球实际国内生产总值（GDP）增长2.8%，略高于2026年的2.7%，但经济增长风险整体偏向下行。高盛认为，能源价格回落和人工智能（AI）资本开支持续强劲，将抵消金融条件收紧及财政政策刺激力度减弱带来的拖累。预计2027年全球AI投资将从2026年的1.1万亿美元增至1.8万亿美元。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937072418.html","kind":"资讯","entityCodes":["159945","CN-MARKET"],"entities":[{"kind":"fund","code":"159945","name":"能源ETF广发","basis":"source-security-code"},{"kind":"market","code":"CN-MARKET","name":"市场环境","basis":"market-context-only"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937072418","publishedAt":"2026-11-23 09:41:35","topics":[{"id":"policy","label":"政策与监管"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937072418.html","source":"东方财富快讯"}]},{"id":"evt-d33782a0f04993ed1d6349ef","entityCode":"159945","entityName":"能源ETF广发","title":"高盛：美联储有望明年底降息 推动货币政策回归常态","summary":"【高盛：美联储有望明年底降息 推动货币政策回归常态】高盛预计，2027年全球实际国内生产总值（GDP）增速为2.8%，略高于该机构对2026年2.7%的预测，但整体风险偏向下行。高盛预计，明年全球主要经济体将出现金融条件收紧、财政政策回归中性，不过这一变动对全球经济带来的拖累，将被走低的能源价格以及依旧旺盛的人工智能资本开支所对冲。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937066561.html","kind":"资讯","entityCodes":["159945","CN-MARKET"],"entities":[{"kind":"fund","code":"159945","name":"能源ETF广发","basis":"source-security-code"},{"kind":"market","code":"CN-MARKET","name":"市场环境","basis":"market-context-only"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937066561","publishedAt":"2026-11-23 09:29:14","topics":[{"id":"policy","label":"政策与监管"}],"entityHints":[],"contentCoverage":"source-feed","