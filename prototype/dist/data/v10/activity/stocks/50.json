】华润江中(600750.SH)公告称，公司近日收到澳门特别行政区政府药物监督管理局核准签发的复方草珊瑚含片《中成药注册证明书》，该药品为非处方中成药，可在澳门销售，有利于公司拓展境外市场业务，预计不会对近期经营业绩产生实质性影响。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937290991.html","kind":"资讯","entityCodes":["600750"],"entities":[{"kind":"stock","code":"600750","name":"华润江中","basis":"source-security-code"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937290991","publishedAt":"2026-11-23 16:20:55","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937290991.html","source":"东方财富快讯"}]},{"id":"evt-ceacdf29824dc98cbcca4722","entityCode":"600750","entityName":"华润江中","title":"刘烈宏赴江西省调研数据要素市场化配置改革工作推进情况","summary":"【刘烈宏赴江西省调研数据要素市场化配置改革工作推进情况】人民财讯11月22日电，近日，国家数据局党组书记、局长刘烈宏带队赴江西省南昌市，实地调研江西省数字产业集团有限公司、华润江中药业股份有限公司、江西一脉阳光集团股份有限公司、江西时刻互动科技股份有限公司，并召开数字中国建设调研座谈会，深入了解地方推进数据要素市场化配置改革的问题和意见建议。","date":"2026-11-22","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611223936886762.html","kind":"资讯","entityCodes":["600750"],"entities":[{"kind":"stock","code":"600750","name":"华润江中","basis":"unambiguous-name","matchedText":"华润江中药业股份有限公司"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611223936886762","publishedAt":"2026-11-22 13:22:00","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611223936886762.html","source":"东方财富快讯"}]}],"forum":{"records":[],"claims":[],"metrics":[],"listCoverage":null,"storedPostCount":0}},"stock000050":{"news":[{"id":"evt-10cae9f04cb017dc4b831cd6","entityCode":"000050","entityName":"深天马Ａ","title":"深天马A：公司非显业务总体规模还很小","summary":"【深天马A：公司非显业务总体规模还很小】深天马A近日接受机构调研时表示，公司持续聚焦显示主业，同时积极推进非显示应用技术开发，建立了MPG平台（多项目玻璃基板技术平台），稳步推进与行业伙伴在面板级智能天线、智能调光玻璃、玻璃基封装基板、微流控生物芯片、指纹识别等领域开展技术开发与合作。截至目前，公司非显业务总体规模还很小，主要还处在孵化和培育期，对公司现有经营业绩无明显影响，未来公司能否实现在相关领域的规模量产及预期效益，存在不确定性。","date":"2026-11-22","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611223936935870.html","kind":"资讯","entityCodes":["000050"],"entities":[{"kind":"stock","code":"000050","name":"深天马Ａ","basis":"source-security-code"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611223936935870","publishedAt":"2026-11-22 19:57:54","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611223936935870.html","source":"东方财富快讯"}]}],"forum":{"records":[],"claims":[],"metrics":[],"listCoverage":null,"storedPostCount":0}},"stock002050":{"news":[],"forum":{"records":[],"claims":[{"objectId":"stock002050","objectName":"三花智控","date":"2026-11-23","claims":[],"postCount":297,"status":"missing-price","coverage":{"checkedAt":"2026-11-24T19:05:38+08:00","publicationDay":"2026-11-23","status":"last-activity-boundary","posts":297,"commentsComplete":false},"promptVersion":"forum-claims-2026-11-24-v3-chunks"}],"metrics":[{"objectId":"stock002050","date":"2026-11-23","observedAt":"2026-11-24T19:05:38+08:00","sampledPosts":297,"readCount":75494,"commentCount":386,"coverage":"last-activity-boundary","zScore":null,"interactivePostRatio":0.3872053872053872,"dailyChangeRatio":null,"countBasis":"previous-day-posts; cumulative engagement observed at collection"}],"listCoverage":null,"storedPostCount":297}}}}
