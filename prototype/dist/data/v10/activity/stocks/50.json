:[{"kind":"stock","code":"000333","name":"美的集团","basis":"source-security-code"},{"kind":"stock","code":"300750","name":"宁德时代","basis":"unambiguous-name","matchedText":"宁德时代"},{"kind":"stock","code":"600519","name":"贵州茅台","basis":"source-security-code"},{"kind":"stock","code":"601857","name":"中国石油","basis":"unambiguous-name","matchedText":"中国石油"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937112635","publishedAt":"2026-11-23 10:46:01","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937112635.html","source":"东方财富快讯"}]},{"id":"evt-30e13269042b04fe1efa79b1","entityCode":"300750","entityName":"宁德时代","title":"DeepSeek最新融资故事：谁在投？有钱就能入局吗？","summary":"【DeepSeek最新融资故事：谁在投？有钱就能入局吗？】过去创投圈是投资人挑项目，这次，是项目挑投资人。机构挤破头抢份额，还要接受严格的穿透审查、漫长的资金锁定期，绝大多数资金只能通过梁文锋控制的SPV（特殊目的载体）间接入股。一边是市场FOMO（害怕错过）情绪汹涌，把这笔投资当成一张“行业名片”；另一边企业主动清退不合规出资人，优先接纳手握产业资源的战略投资方。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611223936964321.html","kind":"资讯","entityCodes":["300750"],"entities":[{"kind":"stock","code":"300750","name":"宁德时代","basis":"source-security-code"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611223936964321","publishedAt":"2026-11-23 08:58:01","topics":[{"id":"capital","label":"资本事项"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611223936964321.html","source":"东方财富快讯"}]},{"id":"evt-24d6d69fe7ba197c6d696216","entityCode":"002463","entityName":"沪电股份","title":"回购增持密集落地 一年多次分红成常态 A股市场投融资生态加速转变","summary":"【回购增持密集落地 一年多次分红成常态 A股市场投融资生态加速转变】从大额分红承诺到密集回购增持，上市公司以“真金白银”回馈投资者的动作持续不断。权威数据显示：今年四季度以来，沪深上市公司共新增披露334单回购计划，预计回购金额