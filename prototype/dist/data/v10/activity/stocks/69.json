1-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937516243.html","kind":"资讯","entityCodes":["601969"],"entities":[{"kind":"stock","code":"601969","name":"海南矿业","basis":"source-security-code"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937516243","publishedAt":"2026-11-23 20:36:57","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937516243.html","source":"东方财富快讯"}]}],"forum":{"records":[],"claims":[],"metrics":[],"listCoverage":null,"storedPostCount":0}},"stock601869":{"news":[{"id":"evt-5940e958e4084fb627d2a4d9","entityCode":"601869","entityName":"长飞光纤","title":"贝莱德在长飞光纤光缆H股的持股比例于11月18日从6.44%降至5.60%","summary":"【贝莱德在长飞光纤光缆H股的持股比例于11月18日从6.44%降至5.60%】香港交易所信息显示，贝莱德在长飞光纤光缆H股的持股比例于11月18日从6.44%降至5.60%。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937338548.html","kind":"资讯","entityCodes":["601869"],"entities":[{"kind":"stock","code":"601869","name":"长飞光纤","basis":"source-security-code"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937338548","publishedAt":"2026-11-23 17:03:51","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937338548.html","source":"东方财富快讯"}]}],"forum":{"records":[],"claims":[],"metrics":[],"listCoverage":null,"storedPostCount":0}},"stock688169":{"news":[{"id":"evt-07c7ab76ec4b84668ac23b1e","entityCode":"688169","entityName":"石头科技","title":"多措并举扩内需 消费市场亮点频现","summary":"【多措并举扩内需 消费市场亮点频现】今年以来，扩大内需、提振消费被摆在更加突出的位置。一系列促消费政策持续显效。国家统计局数据显示，1月份至10月份，社会消费商品和服务零售总额同比增长2.5%，其中服务零售额增长4.9%，商品零售额增长0.9%。在消费市场