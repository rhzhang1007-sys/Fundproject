他担任中信证券山东子公司总业务督察，负责业务协同、合规督察及风险管控，并推动综合业务转型发展。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937087615.html","kind":"资讯","entityCodes":["600030"],"entities":[{"kind":"stock","code":"600030","name":"中信证券","basis":"unambiguous-name","matchedText":"中信证券"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937087615","publishedAt":"2026-11-23 09:59:11","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937087615.html","source":"东方财富快讯"}]},{"id":"evt-111fba5cba7b0c47128803d3","entityCode":"300789","entityName":"唐源电气","title":"中信证券股份有限公司关于成都唐源电气股份有限公司向特定对象发行股票之发行保荐书（2026年三季报数据更新版）","summary":"","date":"2026-11-23","source":"巨潮资讯","url":"https://static.cninfo.com.cn/finalpage/2026-11-23/1225684123.PDF","kind":"公告","entityCodes":["300789","600030"],"entities":[{"kind":"stock","code":"300789","name":"唐源电气","basis":"source-security-code"},{"kind":"stock","code":"600030","name":"中信证券","basis":"unambiguous-name","matchedText":"中信证券股份有限公司"}],"summaryBasis":"title-only","sourceRecordId":"cninfo:1225684123","publishedAt":"2026-11-23T18:50:09+08:00","topics":[{"id":"earnings","label":"业绩"}],"entityHints":[],"contentCoverage":"title-only","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://static.cninfo.com.cn/finalpage/2026-11-23/1225684123.PDF","source":"巨潮资讯"}]},{"id":"evt-9722fa8621d77f2ea44a93d0","entityCode":"600030","entityName":"中信证券","title":"中信证券：美股2027年AI产业链预计呈现年初估值承压、年中估值修复、年末表现分化的阶段性特征","summary":"【中信证券：美股2027年AI产业链预计呈现年初估值承压、年中估值修复、年末表现分化的阶段性特征】中信证券最新研报指出，2027年AI产业链预计呈现年初估值承压、年中估值修复、年末表现分化的阶段性特征。目前至明年一季度，数据中心监管趋严叠加CSP资本开支与经营现金流错配的担忧，或压制产业链整体估值，并加剧新兴云服务商的融资压力。","date":"2026-11-22","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611223936918621.html","kind":"资讯","entityCodes":["600030"],"entities":[{"kind":"stock","code":"600030","name":"中信证券","basis":"unambiguous-name","matchedText":"中信证券"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611223936918621","publishedAt":"2026-11-22 17:50:20","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611223936918621.html","source":"东方财富快讯"}]},{"id":"evt-0a1a5472d80694f93204577a","entityCode":"600030","entityName":"中信证券","title":"中信证券：极端的估值结构最终会得以修正 变局可能在明年","summary":"【中信证券：极端的估值结构最终会得以修正 变局可能在明年】11月22日，中信证券最新研报指出，对比中美日韩市场各行业龙头公司估值分位，只有A股呈现“U型杠铃凹陷”，纯进攻型品种和纯防御性品种估值分位较高，而杠铃中段长久期公司估值被系统性打折，并且基本面因素无法完全解释。中信证券认为这种极端的估值结构最终会得以修正，变局可能在明年，“行业分散、聚焦龙头”是切实可行的策略。","date":"2026-11-22","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611223936914941.html","kind":"资讯","entityCodes":["600030"],"entities":[{"kind":"stock","code":"600030","name":"中信证券","basis":"unambiguous-name","matchedText":"中信证券"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611223936914941","publishedAt":"2026-11-22 17:15:05","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611223936914941.html","source":"东方财富快讯"}]}],"forum":{"records":[],"claims":[],"metrics":[],"listCoverage":null,"storedPostCount":0}},"stock688530":{"news":[{"id":"evt-4832466cf27d559d08b01c11","entityCode":"688530","entityName":"欧莱新材","title":"欧莱新材：向特定对象发行A股股票获证监会同意注册批复","summary":"【欧莱新材：向特定对象发行A股股票获证监会同意注册批复】欧莱新材(688530.SH)公告称，公司于近日收到证监会出具的《关于同意广东欧莱高新材料股份有限公司向特定对象发行股票注册的批复》，同意公司向特定对象发行股票的注册申请。","d