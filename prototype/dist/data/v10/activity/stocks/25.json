{"schemaVersion":1,"objects":{"stock000725":{"news":[{"id":"evt-fcbf9350513f37e722c6357a","entityCode":"000725","entityName":"京东方Ａ","title":"京东方Ａ：已有超过100×100mm尺寸的24层玻璃基封装载板产出并送样","summary":"【京东方Ａ：已有超过100×100mm尺寸的24层玻璃基封装载板产出并送样】京东方Ａ在投资者关系活动中表示，公司目前已实现高深宽比TGV开孔、深孔填铜、低应力金属布线、高层数压合、高密度布线、低应力切割等玻璃基封装载板全流程工艺拉通，拥有完备玻璃基封装载板制造工艺能力。目前，公司试验线已实现全自动化设备通线，已有超过100×100mm尺寸的24层(11-2-11)玻璃基封装载板产出并送样，客样已通过了相关信赖性测试。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937050127.html","kind":"资讯","entityCodes":["000725"],"entities":[{"kind":"stock","code":"000725","name":"京东方Ａ","basis":"source-security-code"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937050127","publishedAt":"2026-11-23 08:55:00","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937050127.html","source":"东方财富快讯"}]},{"id":"evt-db25ef9b7a1047c82b7d3702","entityCode":"000725","entityName":"京东方Ａ","title":"京东方Ａ：第8.6代AMOLED生产线正按计划稳步推进产能爬坡和良率提升","summary":"【京东方Ａ：第8.6代AMOLED生产线正按计划稳步推进产能爬坡和良率提升】京东方Ａ在投资者关系活动中表示，公司第8.6代AMOLED生产线在技术与产品性能方面位居全球第一阵营。该条生产线自量产以来，正按计划稳步推进产能爬坡和良率提升，以应对客户高端中尺寸显示产品需求。客户导入方面，目前多家客户产品处于新品验证阶段，相关客户验证均有序推进。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937050076.html","kind":"资讯","entityCodes":["000725"],"entities":[{"kind":"stock","code":"000725","name":"京东方Ａ","basis":"source-security-code"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937050076","publishedAt":"2026-11-23 08:54:00","topics":[{"id":"orders","label":"订单与经营"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937050076.html","source":"东方财富快讯"}]},{"id":"evt-9b37baca50a2b095c70f78b7","entityCode":"000725","entityName":"京东方Ａ","title":"18只主动ETF今日上市 中国银行被合计持有股数最高","summary":"【18只主动ETF今日上市 中国银行被合计持有股数最高】根据最新披露的PCF清单，截至上市前（11月20日）首批主动ETF的成分股记录数从35只至480只不等，其中成分股超过100只的均为含量化策略产品。以合计持股数结合最小申赎单位进行计算后按高低排序，中国银行合计被持有股数最多，跟随其后的是中国石化、京东方A、中国建筑、工商银行、中国石油、中国中车、农业银行、国电电力、江苏银行。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937069248.html","kind":"资讯","entityCodes":["000725","600028","600795","600919","601288","601398","601668","601766","601857","601988"],"entities":[{"kind":"stock","code":"000725","name":"京东方Ａ","basis":"unambiguous-name","matchedText":"京东方A"},{"kind":"stock","code":"600028","name":"中国石化","basis":"unambiguous-name","matchedText":"中国石化"},{"kind":"stock","code":"600795","name":"国电电力","basis":"unambiguous-name","matchedText":"国电电力"},{"kind":"stock","code":"600919","name":"江苏银行","basis":"unambiguous-name","matchedText":"江苏银行"},{"kind":"stock","code":"601288","name":"农业银行","basis":"unambiguous-name","matchedText":"农业银行"},{"kind":"stock","code":"601398","name":"工商银行","basis":"unambiguous-name","matchedText":"工商银行"},{"kind":"stock","code":"601668","name":"中国建筑","basis":"unambiguous-name","matchedText":"中国建筑"},{"kind":"stock","code":"601766","name":"中国中车","basis":"unambiguous-name","matchedText":"中国中车"},{"kind":"stock","code":"601857","name":"中国石油","basis":"unambiguous-name","matchedText":"中国石油"},{"kind":"stock","code":"601988","name":"中国银行","basis":"source-security-code"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937069248","publishedAt":"2026-11-23 09:36:09","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937069248.html","source":"东方财富快讯"}]}],"forum":{"records":[],"claims":[],"metrics":[],"list