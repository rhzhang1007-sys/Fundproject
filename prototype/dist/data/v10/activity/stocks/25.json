月19日，郭祥玉带队调研成都瑞雪丰泰精密电子公司和成都电气公司，详细了解超高精度射频类、太赫兹类及激光通信精密零组件产品制造流程、核心技术及市场应用情况、高端工业节能透平装备研发制造等情况。11月20日，郭祥玉带队赴重庆与中国长安汽车党委书记、董事长朱华荣，党委常委、总会计师王锟就加强多领域合作座谈交流，并调研中国长安汽车天枢智能实验室，深入了解首个央企自研智能驾驶辅助解决方案——长安天枢领航及中国长安汽车在智能化、未来产业领域的发展成果。在渝期间，郭祥玉还带队会见了重庆市科技局党委书记、局长方磊，双方围绕强化资本赋能、推动科技创新与产业创新深度融合进行交流。","date":"2026-11-22","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611223936870248.html","kind":"资讯","entityCodes":["000625"],"entities":[{"kind":"stock","code":"000625","name":"长安汽车","basis":"source-security-code"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611223936870248","publishedAt":"2026-11-22 08:46:00","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611223936870248.html","source":"东方财富快讯"}]}],"forum":{"records":[],"claims":[],"metrics":[],"listCoverage":null,"storedPostCount":0}}}}
