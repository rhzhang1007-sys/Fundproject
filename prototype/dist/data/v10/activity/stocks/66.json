与注册进入验证期，各技术路线赛道分化且催化密集。随着出海增加、战略联盟兴起，将面对更大的市场和更复杂的竞争环境，机遇和风险并存。建议围绕创新、国际化把握机会，同时建议加大关注边际改善主线。整体兼顾成长弹性与兑现能力，优选具备差异化管线、全球化能力及经营改善确定性的细分龙头。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937036880.html","kind":"资讯","entityCodes":["601066"],"entities":[{"kind":"stock","code":"601066","name":"中信建投","basis":"unambiguous-name","matchedText":"中信建投"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937036880","publishedAt":"2026-11-23 07:55:00","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937036880.html","source":"东方财富快讯"}]},{"id":"evt-5680e8281b209c4545138890","entityCode":"601066","entityName":"中信建投","title":"中信建投：全球封测产业景气上行 BIS新规下国产先进封装扩产有望加速","summary":"【中信建投：全球封测产业景气上行 BIS新规下国产先进封装扩产有望加速】中信建投发布全球封测产业跟踪研报称，基本面方面，2026年三季度海外封测板块实现营业收入772亿元，创2021年以来单季度新高，同比增长19%，环比增长16%。国内封测板块实现营业收入327亿元，同比增长28%，环比增长7%。2026年三季度海内外多数公司毛利率持续提升。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937036651.html","kind":"资讯","entityCodes":["601066"],"entities":[{"kind":"stock","code":"601066","name":"中信建投","basis":"unambiguous-name","matchedText":"中信建投"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937036651","publishedAt":"2026-11-23 07:54:00","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937036651.html","source":"东方财富快讯"}]},{"id":"evt-4af501007180f242bf542a51","entityCode":"601066","entityName":"中信建投","title":"中信建投证券股份有限公司关于思特威（上海）电子科技股份有限公司使用部分闲置募集资金进行现金管理的核查意见","summary":"","date":"2026-11-23","source":"巨潮资讯","url":"http