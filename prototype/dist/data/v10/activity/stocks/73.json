{"schemaVersion":1,"objects":{"stock000973":{"news":[{"id":"evt-f5d5cc0a0c39e8f9ddb0bb06","entityCode":"000789","entityName":"万年青","title":"上周末三家地方国资上市公司密集调整董事长 均系工作调动","summary":"【上周末三家地方国资上市公司密集调整董事长 均系工作调动】11月20日至22日，A股市场迎来一波地方国资上市公司董事长人事调整潮。新五丰（600975.SH）、佛塑科技（000973.SZ）、万年青（000789.SZ）先后发布公告，公司董事长因工作调动或组织安排辞去职务。三家企业均属地方国有控股上市公司，本次人事变动均源于国资系统内部干部统筹任用，属于正常组织调整范畴，且各家均已完成过渡安排，生产经营未受明显冲击。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937148994.html","kind":"资讯","entityCodes":["000789","000973","600975"],"entities":[{"kind":"stock","code":"000789","name":"万年青","basis":"unambiguous-name","matchedText":"万年青"},{"kind":"stock","code":"000973","name":"佛塑科技","basis":"source-security-code"},{"kind":"stock","code":"600975","name":"新五丰","basis":"source-security-code"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937148994","publishedAt":"2026-11-23 12:37:10","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937148994.html","source":"东方财富快讯"}]}],"forum":{"records":[],"claims":[],"metrics":[],"listCoverage":null,"storedPostCount":0}},"stock300473":{"news":[{"id":"evt-de1c02a204f39c6afbfa5e4b","entityCode":"300473","entityName":"德尔股份","title":"德尔股份：电芯中试线在调试过程中 PACK生产线已投入运行","summary":"【德尔股份：电芯中试线在调试过程中 PACK生产线已投入运行】德尔股份(300473)日前在接待机构调研时介绍，公司电芯中试线及PACK生产线（原PACK中试线）均已建设完成。其中，电芯中试线在调试过程中，PACK生产线已投入运行。此外，公司已与外部合作方签订了电池生产的委托加工协议，该产线现处于试生产与产能爬坡阶段。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937107555.html","kind":"资讯","entityCodes":["300473"],"entities":[{"kind":"stock","code":"300473","name":"德尔股份","basis":"source-security-code"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937107555","publishedAt":"2026-11-23 10:29:00","topics":[{"id":