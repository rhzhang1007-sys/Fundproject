ney.com/news,600084,1801760605.html","date":"2026-11-26","publishedAt":"2026-11-26 10:45:28","source":"东方财富股吧","readCount":21,"commentCount":0,"content":null,"coverage":{"comments":"partial","fetchedComments":0},"boardVerified":true,"nativeBoard":"600084","comments":[]},{"id":"1801723059","objectId":"stock600084","title":"我只能说，主力只手遮天，想怎么样就怎么样","url":"https://guba.eastmoney.com/news,600084,1801723059.html","date":"2026-11-26","publishedAt":"2026-11-26 10:22:12","source":"东方财富股吧","readCount":129,"commentCount":2,"content":null,"coverage":{"comments":"partial","fetchedComments":0},"boardVerified":true,"nativeBoard":"600084","comments":[]},{"id":"1801721583","objectId":"stock600084","title":"但将死户为生户，莫执生门号死门","url":"https://guba.eastmoney.com/news,600084,1801721583.html","date":"2026-11-26","publishedAt":"2026-11-26 10:21:25","source":"东方财富股吧","readCount":49,"commentCount":1,"content":null,"coverage":{"comments":"partial","fetchedComments":0},"boardVerified":true,"nativeBoard":"600084","comments":[]},{"id":"1801697441","objectId":"stock600084","title":"今天补跌，破3元是大概率事件","url":"https://guba.eastmoney.com/news,600084,1801697441.html","date":"2026-11-26","publishedAt":"2026-11-26 10:09:10","source":"东方财富股吧","readCount":248,"commentCount":20,"content":null,"coverage":{"comments":"partial","fetchedComments":0},"boardVerified":true,"nativeBoard":"600084","comments":[]},{"id":"1801660341","objectId":"stock600084","title":"100万进场了","url":"https://guba.eastmoney.com/news,600084,1801660341.html","date":"2026-11-26","publishedAt":"2026-11-26 09:52:52","source":"东方财富股吧","readCount":26,"commentCount":0,"content":"$*ST尼雅(SH600084)$ 100万进场了","coverage":{"comments":"complete","fetchedComments":0,"body":"complete","reportedComments":0,"commentSource":"embedded-page","bodySource":"embedded-post-article","contentTruncated":false},"boardVerified":true,"nativeBoard":"600084","comments":[]},{"id":"1801642547","objectId":"stock600084","title":"马上跌到3元以下了！然后就是2块钱！年报一出宣布退市大吉了！中信真是垃圾不能在垃","url":"https://guba.eastmoney.com/news,600084,1801642547.html","date":"2026-11-26","publishedAt":"2026-11-26 09:45:59","source":"东方财富股吧","readCount":124,"commentCount":2,"content":"马上跌到3元以下了！然后就是2块钱！年报一出宣布退市大吉了！中信真是垃圾不能在垃圾的股票了！","coverage":{"comments":"complete","fetchedComments":2,"body":"complete","reportedComments":2,"commentSource":"public-web-and-child-pagination","bodySource":"embedded-post-article","contentTruncated":false},"boardVerified":true,"nativeBoard":"600084","comments":[{"id":"9983697940","text":"昨天ST股普遍都涨，而它明明很有摘帽的希望，依旧是绿的，其中一个原因就是牛散持股太重，外面的资金都躲着它。","at":"2026-11-26 10:02:59","replyTo":null},{"id":"9983691146","text":"拿了大半年 天天阴跌 割了又不甘心 硬扛吧","at":"2026-11-26 09:56:07","replyTo":null}]},{"id":"1801555499","objectId":"stock600084","title":"尼雅原注册地址红山路39号也是综合楼，楼内还有很多商贸类企业，一层门市房还租给了","url":"https://guba.eastmoney.com/news,600084,1801555499.html","date":"2026-11-26","publishedAt":"2026-11-26 08:07:51","source":"东方财富股吧","readCount":325,"commentCount":7,"content":"尼雅原注册地址红山路39号也是综合楼，楼内还有很多商贸类企业，一层门市房还租给了好想来、牛肉面一些餐饮商户，这地方人多混杂，办公环境很差，停车非常困难。尼雅在注册地址仅有9名员工办公，其余350多人都在昌吉尼雅葡萄酒工厂。所以，只有9个人办公注册地本可以不用变更，却要在这个时间迁移注册地址到南湖南路66号。这是什么原因？","coverage":{"comments":"partial","fetchedComments":5,"body":"complete","reportedComments":7,"commentSource":"public-web-and-child-pagination","bodySource":"embedded-post-article","contentTruncated":false,"commentError":"Repeated comment page; source did not paginate"},"boardVerified":true,"nativeBoard":"600084","comments":[{"id":"9983700060","text":"这是要倒闭了","at":"2026-11-26 10:04:58","replyTo":null},{"id":"9983648497","text":"先说结论：属于市场一个很合理的猜想，但目前没有任何公告、工商信息实锤，只能当作潜在剧本，不能当成既定事实。 这个猜想成立的逻辑 国安实业本身在新疆有矿产布局（东戈壁钼矿、塔城资源合作），本来就有在乌鲁木齐设立区域前台、新疆项目平台的需求，需要一处固定办公点对接政府、项目方 。 尼雅只留9个人在红山路39号，主体搬迁之后，2-4层空间完整腾出来，位置在乌鲁木齐核心区，现成装修、会议室配套齐全，拿来做集团新疆区域平台很合适，不用额外再去租写字楼。 性质上属于上市公司资产出租给控股股东关联方，是标准关联交易；走董事会评估、公告流程即可，合规路径是通的。 好处是：租客稳定、回款稳，不用在市场上散租承担空置风险，租金收益确定性强，对尼雅是稳定的扣非增益。 几个关键约束，决定它不一定会这么做 关联交易监管很严：不能低价租给集团，租金要第三方评估公允价，价格不能明显低于周边市场价，否则交易所会问询，这是年报敏感期，管理层会很谨慎。 国安实业的总部在北京；新疆的矿产项目主体本身是新疆洛钼这类独立项目公司，不是必须单独再新设一个集团新疆总部。也可以直接由项目公司自行租办公室，不一定非要用尼雅这栋楼。 还有替代方案：对外市场化散租、或者未来整体出售房产。出售是资产处置收益，不计入扣非净利润；出租才是经常性租金收入，计入扣非，这是两条完全不同的路线。 后续用来验证这个猜想的信号（盯这几点） 公告发布《关联租赁公告》，承租方是国安实业旗下新设新疆主体 工商新增注册企业，注册地址落在红山路39号2/3/4层 资产评估报告，披露该房产的租赁评估价 备忘一句话 猜想：红山路腾退后交给国安实业新设新疆平台办公，逻辑通顺、合规路径可行，租金稳定利于扣非；但暂无实锤，还要看后续关联交易公告。","at":"2026-11-26 08:58:02","replyTo":null},{"id":"9983648076","text":"先说前提：年报没有披露红山路39号2-4层精确建筑面积，只能拿同片区同类型红山路综合楼案例做估算参考（红山路35号同地段综合楼4层是984.5，挂牌年租金45万） 参考样本：红山路隔壁35号综合楼4层：984.5，年租金45万 → 折算单价约 456元//年 估算假设（保守口径） 假设红山路39号每层≈980，2、3、4三层合计：2940 老综合楼、停车差、丙级，取保守租金：420元//年（低于隔壁35号） 理论满租总收入：2940 × 420 ≈ 123.5万元/年 按月：约10.3万/月 现实要扣减几项（很关键，直接影响扣非） 空置率：这类老综合楼，正常会有10%~20%空置，扣掉后大约 98万～110万/年 物业费、维修、电梯维保、房产税（12%租金税）：大约吃掉20%左右租金 到手净收益大致区间：75万～90万/年 重点提醒（放到跟踪清单里的要点） 这个收益量级：几十万级别，对摘帽扣非有小幅加分，但单独靠它不足以扭转扣非，远不如北酒所处置的影响大 不是想租就能马上确认收益：属于关联资产出租，要评估、上董事会、公告，不能年内突击确认；如果今年来不及招租，今年一分钱租金利润都拿不到 也存在另一条路：整体打包出售该房产，一次性确认资产处置收益（弹性更大，但属于资产处置损益，不计入扣非净利润！这点非常重要）","at":"2026-11-26 08:57:02","replyTo":null},{"id":"9983638074","text":"张裕纯粹是以葡萄酒为主业，经营范围没有其他想法","at":"2026-11-26 08:28:15","replyTo":null},{"id":"9983637352","text":"中粮长城以葡萄酒为主业，把葡萄酒列为经营范围主项。","at":"2026-11-26 08:25:50","replyTo":null}]}]}
