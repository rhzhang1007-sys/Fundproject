guba.eastmoney.com/news,002277,1801440606.html","date":"2026-11-25","publishedAt":"2026-11-25 18:03:45","source":"东方财富股吧","readCount":31,"commentCount":0,"content":null,"coverage":null,"boardVerified":true,"nativeBoard":"002277","comments":[]},{"id":"1801435362","objectId":"stock002277","title":"上会稿原文：2024年12月9日，友阿控股与上海勤学堂投资控股有限公司签署《股票","url":"https://guba.eastmoney.com/news,002277,1801435362.html","date":"2026-11-25","publishedAt":"2026-11-25 17:42:03","source":"东方财富股吧","readCount":1043,"commentCount":17,"content":null,"coverage":null,"boardVerified":true,"nativeBoard":"002277","comments":[]},{"id":"1801428172","objectId":"stock002277","title":"大盘根本没人信了。拉升就是逃跑的机会","url":"https://guba.eastmoney.com/news,002277,1801428172.html","date":"2026-11-25","publishedAt":"2026-11-25 17:17:22","source":"东方财富股吧","readCount":38,"commentCount":1,"content":null,"coverage":null,"boardVerified":true,"nativeBoard":"002277","comments":[]},{"id":"1801426582","objectId":"stock002277","title":"友阿跟大盘跌破34","url":"https://guba.eastmoney.com/news,002277,1801426582.html","date":"2026-11-25","publishedAt":"2026-11-25 17:12:26","source":"东方财富股吧","readCount":30,"commentCount":0,"content":null,"coverage":null,"boardVerified":true,"nativeBoard":"002277","comments":[]},{"id":"1801423807","objectId":"stock002277","title":"友阿股份：控股股东友阿控股解除质押2000万股","url":"https://guba.eastmoney.com/news,002277,1801423807.html","date":"2026-11-25","publishedAt":"2026-11-25 17:03:31","source":"东方财富股吧","readCount":734,"commentCount":3,"content":"","coverage":{"body":"missing","comments":"complete","fetchedComments":3,"reportedComments":3,"commentSource":"public-web-and-child-pagination","bodySource":"html-body","contentTruncated":false},"boardVerified":true,"nativeBoard":"002277","comments":[{"id":"9983492665","text":"友阿股份20261125分析 先说结论：股价连续下跌，成交量放大，但是股东人数反而是减少的（说明是庄家机构左右手对倒筹码，散户割肉离场导致股东人数减少，如果庄家机构离场，1个机构几千万筹码，要上万个散户才能接完这些筹码，股东人数应该是增加2-3万才对，从最新的减少的股东人数来看，庄家机构还没有走，走的是散户割肉） 庄家机构左右手对倒筹码意图： 1、收集散户割肉的带血筹码，方便日后拉升几倍减少浮筹与阻力。（像九阳股份一样，拉升几倍，没有卖盘，一马平川，就是散户跑完了，全是机构庄家在操盘） 友阿股份未来股价预测： 1、牛散们（刘梦楠、魏巍、张寿春、宋定权、廖梓含等牛散）拍卖花了1个多亿，买入2710 万股，包括利息与税等等，成本在5块以上，并且锁定6个月不能出售，未来6个月之后，股价必须也要上到10-15块，他们才有利润可言。 2、由于银宝向尚阳通37名投资者出资15亿购买资产，37名投资者在3年后才能出售，他们曾经总共向尚阳通投资了100多亿，现在只获得友阿股份给的15亿，必须让股价翻7倍，15*7=105亿，才能回本。相当于让2.29的增发价*7倍=16块，才能回本。未来，这些投资者（包括基金、庄家、机构）必须把股价拉到16-30块之间，才有利润可言。 友阿股份下周股价走势： 1、在5-6块之间震荡继续收割散户割肉的带血筹码，然后在下周公司申请证劵会注册又拉一波到7-8块，让散户抛筹码，在证劵会注册成功，又拉一波8-10块。 在明年年初从10块拉到10-15块，才能让牛散们（刘梦楠、魏巍、张寿春、宋定权、廖梓含等牛散）拍卖获得利润而不亏损。 2、明年2027-2028年，股价要拉到16-30块，尚阳通37名投资者出资才能获得利润而不亏损。","at":"2026-11-25 20:07:14","replyTo":null},{"id":"9983421203","text":"1个多亿？拿这钱回购自己公司股票吧","at":"2026-11-25 17:32:14","replyTo":null},{"id":"9983413224","text":"还有这么多坏账证监会不可能同意注册","at":"2026-11-25 17:16:05","replyTo":null}]},{"id":"1801422128","objectId":"stock002277","title":"出的公告是利空还是利好呀？","url":"https://guba.eastmoney.com/news,002277,1801422128.html","date":"2026-11-25","publishedAt":"2026-11-25 16:58:35","source":"东方财富股吧","readCount":106,"commentCount":2,"content":"","coverage":{"body":"missing","comments":"complete","fetchedComments":2,"reportedComments":2,"commentSource":"public-web-and-child-pagination","bodySource":"html-body","contentTruncated":false},"boardVerified":true,"nativeBoard":"002277","comments":[{"id":"9983439167","text":"公告千万不要看，看公告买绝对死定了","at":"2026-11-25 18:12:06","replyTo":null},{"id":"9983413020","text":"利尿","at":"2026-11-25 17:15:40","replyTo":null}]},{"id":"1801421812","objectId":"stock002277","title":"拼了，继续补仓","url":"https://guba.eastmoney.com/news,002277,1801421812.html","date":"2026-11-25","publishedAt":"2026-11-25 16:57:35","source":"东方财富股吧","readCount":531,"commentCount":10,"content":"","coverage":{"body":"missing","comments":"partial","fetchedComments":9,"reportedComments":10,"commentSource":"public-web-and-child-pagination","bodySource":"html-body","contentTruncated":false,"commentError":"Repeated comment page; source did not paginate"},"boardVerified":true,"nativeBoard":"002277","comments":[{"id":"9983448557","text":"