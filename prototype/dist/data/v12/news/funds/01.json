":[],"contentCoverage":"title-only","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://static.cninfo.com.cn/finalpage/2026-11-25/1225685759.PDF","source":"巨潮基金披露"}]},{"id":"evt-ded483c1dcb956ff875290e5","entityCode":"159001","entityName":"货币ETF易方达","title":"中信证券：看好明年行情宽度拓展 “行情分散、聚焦龙头”是切实可行策略","summary":"【中信证券：看好明年行情宽度拓展 “行情分散、聚焦龙头”是切实可行策略】中信证券研报称，11月22日，监管层发布一揽子稳市举措，包括调整融资保证金、在创业板推进做市商制度、发布一揽子降费举措等三项举措。近期受海外风险扰动，国内市场波动较大，这些举措直击市场痛点，在杠杆资金持续净流出、创业板指大幅调整的背景下，一方面通过降低融资保证金比例释放融资空间、提升市场流动性，另一方面通过引入做市商制度，为创业板带来增量资金、提供“缓冲垫”保护。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937042514.html","kind":"资讯","entityCodes":["159001","159915","600030"],"entities":[{"kind":"fund","code":"159001","name":"货币ETF易方达","basis":"source-security-code"},{"kind":"fund","code":"159915","name":"创业板ETF易方达","basis":"source-security-code"},{"kind":"stock","code":"600030","name":"中信证券","basis":"unambiguous-name","matchedText":"中信证券"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937042514","publishedAt":"2026-11-23 08:14:00","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937042514.html","source":"东方财富快讯"}]},{"id":"evt-24038cf87d52cbf442fdfc00","entityCode":"159001","entityName":"货币ETF易方达","title":"美国对进口自中国的三（羟甲基）氨基甲烷作出反倾销初裁","summary":"【美国对进口自中国的三（羟甲基）氨基甲烷作出反倾销初裁】据中国贸易救济信息网消息，2026年11月20日，美国商务部发布公告，对进口自中国的三（羟甲基）氨基甲烷（Tris (hydroxymethyl) aminomethane）作出反倾销初裁，初步裁定中国出口商/生产商倾销幅度为9.07%—132.59%。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937449417.html","kind":"资讯","entityCodes":["159001","CN-UNASSIGNED"],"entities":[{"kind":"fund","code":"159001","name":"货币ETF易方达","basis":"source-security-code"},{"kind":"unassigned","code":"CN-UNASSIGNED","name":"待归属资讯","basis":"source-read-entity-unresolved"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937449417","publishedAt":"2026-11-23 19:14:07","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937449417.html","source":"东方财富快讯"}]},{"id":"evt-1d465de3f3071e37382ebd1b","entityCode":"159001","entityName":"货币ETF易方达","title":"资本市场“三箭齐发”！李大霄：政策组合拳加速稳定市场 散户需理性看待、量力而为","summary":"【资本市场“三箭齐发”！李大霄：政策组合拳加速稳定市场 散户需理性看待、量力而为】李大霄表示，沪深北交易所将融资买入证券最低保证金比例由100%下调至80%，能够有效缓解平仓盘连环下行风险，是抵御输入性风险的举措。但该措施并非鼓励加杠杆，散户投资者，尤其是风险承受能力较弱的散户，应当理性看待相关政策，量力而行。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937157278.html","kind":"资讯","entityCodes":["159001","CN-MARKET"],"entities":[{"kind":"fund","code":"159001","name":"货币ETF易方达","basis":"source-security-code"},{"kind":"market","code":"CN-MARKET","name":"市场环境","basis":"market-context-only"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937157278","publishedAt":"2026-11-23 13:13:09","topics":[{"id":"policy","label":"政策与监管"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937157278.html","source":"东方财富快讯"}]},{"id":"evt-0ec5815ef1eaca478cb1a6ee","entityCode":"159001","entityName":"货币ETF易方达","title":"广发证券陈福：多举措协同发力 资本市场内在稳定性有望提升","summary":"【广发证券陈福：多举措协同发力 资本市场内在稳定性有望提升】广发证券非银首席分析师陈福认为，多项举措从融资端、交易端、投资端协同发力，资本市场内在稳定性有望进一步提升。陈福表示，据测算，此次下调融资保证金比例预计可带来近4000亿元增量资金，若成交额回升、风险偏好改善，持仓标的价格或企稳回升，担保比例有望随之改善。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937130690.html","kind":"资讯","entityCodes":["000776","159001"],"entities":[{"kind":"fund","code":"159001","name":"货币ETF易方达","basis":"source-security-code"},{"kind":"stock","code":"000776","name":"广发证券","basis":"unambiguous-name","matchedText":"广发证券"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937130690","publishedAt":"2026-11-23 11:30:00","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937130690.html","source":"东方财富快讯"}]},{"id":"evt-f5a49a0c4b475b044a6175b5","entityCode":"159001","entityName":"货币ETF易方达","title":"交易所降低融资保证金比例下限 可带来增量资金近4000亿元","summary":"【沪深北交易所降低融资保证金比例下限至80% 理论上可带来增量资金近4000亿元】经证监会批准，沪深北交易所将融资保证金比例下限从100%降低至80%，此次调整将自2026年11月30日起实施。据测算，此次调整理论上可带来增量资金近4000亿元。","date":"2026-11-22","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611223936924279.html","kind":"资讯","entityCodes":["159001","CN-MARKET"],"entities":[{"kind":"fund","code":"159001","name":"货币ETF易方达","basis":"source-security-code"},{"kind":"market","code":"CN-MARKET","name":"市场环境","basis":"market-context-only"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611223936924279","publishedAt":"2026-11-22 18:37:21","topics":[{"id":"capital","label":"资本事项"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611223936924279.html","source":"东方财富快讯"}]},{"id":"evt-ce8367c77d6e7e1fdc544d1f","entityCode":"159001","entityName":"货币ETF易方达","title":"中国台湾地区拟下调融资保证金比例至120%以稳定股市","summary":"【中国台湾地区拟下调融资保证金比例至120%以稳定股市】中国台湾地区正考虑下调融资维持保证金比例，以遏制股市抛售潮。中国台湾证券交易所表示，周日与10家券商召开紧急会议，讨论这一潜在举措。根据拟议方案，最低融资维持保证金比例将从目前的130%下调至120%。","date":"2026-11-22","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611223936948837.html","kind":"资讯","entityCodes":["159001","CN-UNASSIGNED"],"entities":[{"kind":"fund","code":"159001","name":"货币ETF易方达","basis":"source-security-code"},{"kind":"unassigned","code":"CN-UNASSIGNED","name":"待归属资讯","basis":"source-read-entity-unresolved"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611223936948837","publishedAt":"2026-11-22 21:18:16","topics":[{"id":"capital","label":"资本事项"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611223936948837.html","source":"东方财富快讯"}]},{"id":"evt-70d061744bbcaab40ff98efa","entityCode":"159001","entityName":"货币ETF易方达","title":"沪深北交易所降低融资保证金比例下限至80%","summary":"【沪深北交易所调整融资保证金比例】2026年11月22日，经中国证监会批准，沪深北交易所发布通知调整融资保证金比例，将投资者融资买入证券的最低保证金比例由100%调低至80%，相关规则调整自2026年11月30日起施行。","date":"2026-11-22","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611223936923898.html","kind":"资讯","entityCodes":["159001","CN-MARKET"],"entities":[{"kind":"fund","code":"159001","name":"货币ETF易方达","basis":"source-security-code"},{"kind":"market","code":"CN-MARKET","name":"市场环境","basis":"market-context-only"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611223936923898","publishedAt":"2026-11-22 18:33:04","topics":[{"id":"capital","label":"资本事项"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611223936923898.html","source":"东方财富快讯"}]}]},"fund180301":{"news":[{"id":"evt-6208f29811ba9de4f01d5526","entityCode":"180301","entityName":"红土创新盐田港REIT","title":"红土创新基金管理有限公司关于红土创新盐田港仓储物流封闭式基础设施证券投资基金更换存续期评估机构公告","summary":"","date":"2026-11-25","source":"巨潮基金披露","url":"https://static.cninfo.com.cn/finalpage/2026