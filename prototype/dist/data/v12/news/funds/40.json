},{"kind":"market","code":"CN-MARKET","name":"市场环境","basis":"market-context-only"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611223936967278","publishedAt":"2026-11-23 00:19:17","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611223936967278.html","source":"东方财富快讯"}]},{"id":"evt-64a4eb66a96d603b6970ffbb","entityCode":"159940","entityName":"金融地产ETF广发","title":"让存量土地“活”起来","summary":"【让存量土地“活”起来】据苏州市自然资源和规划局11月20日消息，该局印发实施《苏州市土地要素市场化配置改革行动方案》，形成4个方面27条改革举措，围绕重点应用场景推动各项改革举措落地。其中提及，深化存量盘活利用，完善详细规划技术修正适用情形，支持存量建筑在符合安全、消防等前提下临时改变使用功能，满足更新改造实际需求。不止苏州，今年以来，从中央到地方，均在推进存量土地盘活工作。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233936994412.html","kind":"资讯","entityCodes":["159940","CN-UNASSIGNED"],"entities":[{"kind":"fund","code":"159940","name":"金融地产ETF广发","basis":"source-security-code"},{"kind":"unassigned","code":"CN-UNASSIGNED","name":"待归属资讯","basis":"source-read-entity-unresolved"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233936994412","publishedAt":"2026-11-23 08:17:00","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233936994412.html","source":"东方财富快讯"}]},{"id":"evt-6345324f8b576759c8d51b3e","entityCode":"159940","entityName":"金融地产ETF广发","title":"广东：建设国家级绿色期货交易所 推进碳排放权等绿色低碳期货期权品种研发上市","summary":"【广东：建设国家级绿色期货交易所 推进碳排放权等绿色低碳期货期权品种研发上市】广东省人民政府办公厅印发《广东省推进粤港澳大湾区世界级绿色低碳产业集群建设实施方案》，方案提出，深化金融支持绿色发展。设立粤港澳大湾区绿色发展基金。建立完善粤港澳大湾区绿色金融合作机制，探索建立粤港澳大湾区碳市场协同机制、碳普惠共同机制和跨境绿电绿证交易机制。建设国家级绿色期货交易所，推进碳排放权、绿电绿证等绿色低碳期货期权品种研发上市。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937350146.html","kind":"资讯","entityCodes":["159940","CN-UNASSIGNED"],"entities":[{"kind":"fund","code":"159940","name":"金融地产ETF广发","basis":"source-security-code"},{"kind":"unassigned","code":"CN-UNASSIGNED","name":"待归属资讯","basis":"source-read-entity-unresolved"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937350146","publishedAt":"2026-11-23 17:17:00","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937350146.html","source":"东方财富快讯"}]},{"id":"evt-5591bb61edf356e26cfaaf51","entityCode":"159940","entityName":"金融地产ETF广发","title":"中金所增加10年期国债期货合约可交割国债","summary":"【中金所增加10年期国债期货合约可交割国债】中金所公告，2026年中央金融机构注资特别国债（二期）已招标发行。根据《中国金融期货交易所国债期货合约交割细则》及相关规定，该国债符合T2612和T2703合约的可交割国债条件，转换因子分别为0.9014和0.9046。该国债从上市交易日后的下一交易日开始，纳入T2612和T2703的可交割国债范围，可用于交割意向申报。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937288374.html","kind":"资讯","entityCodes":["159940","CN-UNASSIGNED"],"entities":[{"kind":"fund","code":"159940","name":"金融地产ETF广发","basis":"source-security-code"},{"kind":"unassigned","code":"CN-UNASSIGNED","name":"待归属资讯","basis":"source-read-entity-unresolved"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937288374","publishedAt":"2026-11-23 16:16:38","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937288374.html","source":"东方财富快讯"}]},{"id":"evt-42b71406128cbb47bc41252b","entityCode":"159940","entityName":"金融地产ETF广发","title":"美国财政部顾问：上周金融环境收紧","summary":"美国财政部顾问泽尔沃斯表示，上周金融环境收紧。","date":"2026-11-23","source":"东方财富