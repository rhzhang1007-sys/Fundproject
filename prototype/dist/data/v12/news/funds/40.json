率运行的典型规律，都对5年期美国国债的超额收益形成利好支撑。包括威廉·马歇尔在内的策略师在一份报告中写道，当前的收紧压力进一步强化了做多美债收益率曲线“中段”品种的逻辑。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937130461.html","kind":"资讯","entityCodes":["159940","CN-UNASSIGNED"],"entities":[{"kind":"fund","code":"159940","name":"金融地产ETF广发","basis":"source-security-code"},{"kind":"unassigned","code":"CN-UNASSIGNED","name":"待归属资讯","basis":"source-read-entity-unresolved"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937130461","publishedAt":"2026-11-23 11:30:54","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937130461.html","source":"东方财富快讯"}]},{"id":"evt-0539fa3b3096f6a97d230050","entityCode":"159940","entityName":"金融地产ETF广发","title":"证监会主席吴清会见印度驻华大使魏嘉盟","summary":"【证监会主席吴清会见印度驻华大使魏嘉盟】据证监会消息，11月23日，中国证监会主席吴清在京会见了印度驻华大使魏嘉盟(VikramKumarDoraiswami)。双方就全球金融市场形势、中印资本市场改革发展及增进务实合作等议题交换了意见。","date":"2026-11-23","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611233937393253.html","kind":"资讯","entityCodes":["159940","CN-MARKET"],"entities":[{"kind":"fund","code":"159940","name":"金融地产ETF广发","basis":"source-security-code"},{"kind":"market","code":"CN-MARKET","name":"市场环境","basis":"market-context-only"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611233937393253","publishedAt":"2026-11-23 18:26:33","topics":[{"id":"policy","label":"政策与监管"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611233937393253.html","source":"东方财富快讯"}]},{"id":"evt-a86ef6738b2ca5caf1e537ee","entityCode":"159940","entityName":"金融地产ETF广发","title":"韩国将推出分阶段措施以稳定市场波动","summary":"【韩国将推出分阶段措施以稳定市场波动】韩国高层金融官员在周日召开的紧急会议后表示，鉴于市场波动加剧，韩国宣布了分阶段措施以稳定市场，其中包括确保股票稳定基金就绪，以便在必要时采取行动。","date":"2026-11-22","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611223936927486.html","kind":"资讯","entityCodes":["159940","161631","CN-UNASSIGNED"],"entities":[{"kind":"fund","code":"159940","name":"金融地产ETF广发","basis":"source-security-code"},{"kind":"fund","code":"161631","name":"融通人工智能指数(LOF)A","basis":"source-security-code"},{"kind":"unassigned","code":"CN-UNASSIGNED","name":"待归属资讯","basis":"source-read-entity-unresolved"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611223936927486","publishedAt":"2026-11-22 18:56:15","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611223936927486.html","source":"东方财富快讯"}]},{"id":"evt-4841d80f6e2d37b1faa5ce04","entityCode":"159940","entityName":"金融地产ETF广发","title":"韩国救市！已准备好立即部署市场稳定基金","summary":"【韩国财政部：已准备好立即部署市场稳定基金】韩国财政部表示，将放宽每日股票回购限额和密切监控非法卖空行为，为期三个月；已准备好立即部署市场稳定基金。","date":"2026-11-22","source":"东方财富快讯","url":"https://finance.eastmoney.com/a/202611223936917289.html","kind":"资讯","entityCodes":["159940","CN-UNASSIGNED"],"entities":[{"kind":"fund","code":"159940","name":"金融地产ETF广发","basis":"source-security-code"},{"kind":"unassigned","code":"CN-UNASSIGNED","name":"待归属资讯","basis":"source-read-entity-unresolved"}],"summaryBasis":"source-excerpt","sourceRecordId":"fast:202611223936917289","publishedAt":"2026-11-22 17:35:35","topics":[{"id":"other","label":"其他"}],"entityHints":[],"contentCoverage":"source-feed","originPublishedAt":null,"publicationTimeBasis":"source-feed-publish-or-show-time","eventOccurredAt":null,"sourceSecurityRefs":null,"sources":[{"url":"https://finance.eastmoney.com/a/202611223936917289.html","source":"东方财富快讯"}]},{"id":"evt-2d3a195d04bdcc67c4c04b42","entityCode":"159940","e