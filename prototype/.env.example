# Copy to prototype/.env.local, then enter values privately. Never commit that file.
WEB_LLM_API_URL=
WEB_LLM_API_KEY=
WEB_LLM_MODEL=
# Optional backup endpoint; configure only after authorizing that destination.
WEB_LLM_FALLBACK_URL=
# CNY per million tokens. Known, current provider/model may use the verified reference table.
WEB_LLM_PRICE_IN=
WEB_LLM_PRICE_OUT=
WEB_LLM_DAILY_BUDGET=5

# Only for a future shared HTTPS deployment; leave blank for localhost.
WEB_LLM_ORIGIN=
# Separate API hostname for a Pages frontend; leave empty for same-origin/local use.
WEB_LLM_SERVICE_ORIGIN=
# Only the Docker image enables network listening; local use stays on loopback.
WEB_LLM_LISTEN_HOST=127.0.0.1
# Free durable state for a separately hosted backend. Server-only Supabase Secret key.
WEB_STATE_URL=
WEB_STATE_KEY=
WEB_STATE_REQUIRED=false
